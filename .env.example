# Root-level production environment file for docker-compose.prod.yml (and
# docker-compose.observability.yml, if you're using the optional monitoring
# stack). Docker Compose reads a `.env` file from the project root
# automatically for top-level `${VAR}` substitution in the compose files —
# this is a DIFFERENT file from backend/.env.production, which is only
# passed into the backend container itself.
#
# Copy this to `.env` (gitignored) and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d

# --- Required: Postgres credentials ---
# Used both to initialize the `db` service and to construct DATABASE_URL for
# the `backend` service — do not also set DATABASE_URL in
# backend/.env.production, it will be overridden by these anyway.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_long_random_password
POSTGRES_DB=attendance_db

# --- Required only if using docker-compose.observability.yml ---
# Generate with: openssl rand -hex 32
GLITCHTIP_SECRET_KEY=change_this_to_a_long_random_secret
# Public URL you'll reach GlitchTip at over your SSH tunnel (cosmetic —
# used in links GlitchTip generates, e.g. in emails). Fine to leave default
# for an SSH-tunnel-only setup.
GLITCHTIP_DOMAIN=http://localhost:8080
# Grafana's initial admin password (username defaults to "admin")
GRAFANA_ADMIN_PASSWORD=change_this_to_a_long_random_password
