# AuraWork Backend Production Environment Config
ENVIRONMENT=production
SECRET_KEY=generate_a_secure_random_key_using_openssl_rand_hex_32
# DATABASE_URL and REDIS_URL are NOT set here — docker-compose.prod.yml
# constructs DATABASE_URL from the root .env's POSTGRES_* vars (see
# .env.example at the repo root) and sets REDIS_URL directly, and either
# would override whatever is set in this file anyway. Only set DATABASE_URL/
# REDIS_URL here if you're running the backend outside docker-compose.
ALLOWED_ORIGINS=https://aurawork.yourdomain.com,https://app.yourdomain.com

# Error tracking (optional) — DSN from a self-hosted GlitchTip instance
# (see docker-compose.observability.yml) or any Sentry-protocol endpoint.
# Leave blank to disable.
SENTRY_DSN=

# File Storage & S3 (Optional)
S3_BUCKET=aurawork-prod-uploads
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
S3_REGION=us-east-1

# SMTP Email Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com
