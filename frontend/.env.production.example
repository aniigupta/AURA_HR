# AuraWork Frontend Production Environment Config
# Public API URL (accessible by user browsers)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Internal Backend URL (accessible within Docker network)
BACKEND_URL=http://backend:8000

# Error tracking (optional) — same DSN as backend's SENTRY_DSN. Two separate
# vars because NEXT_PUBLIC_* is the only prefix Next.js inlines into
# browser-shipped code; server-side code in this app can read either.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
